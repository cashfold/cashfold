# Settings for deploy/compose.yml. Copy to deploy/.env and edit. Nothing here is read by the web app.

# --- secrets: generate each with `openssl rand -hex 32`; keep them out of version control
SERVER_SECRET=
POSTGRES_PASSWORD=

# --- addresses
# Where the relay listens on this machine. Keep it on 127.0.0.1 and let a reverse proxy add TLS.
LISTEN=127.0.0.1:8080
# The address of the web app, used in links inside emails.
PUBLIC_URL=https://cashfold.example.com
# Web-app origins allowed to call the relay (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://cashfold.example.com

# --- who may register: open, or invite (needs a code from INVITE_CODES)
REGISTRATION=invite
INVITE_CODES=

# --- email: none, log (writes messages to the log) or smtp
MAIL=none
SMTP_URL=
MAIL_FROM=

# --- exchange rates: a URL that returns {"rates": {"EUR": "0.91", ...}} per USD, or disabled
RATES_URL=disabled
RATES_EVERY_HOURS=12

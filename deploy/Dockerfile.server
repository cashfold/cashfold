# Skeleton: build the relay from the pnpm workspace. Pin image digests before release.
FROM node:22-slim AS build
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @cashfold/server build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/apps/server/dist ./dist
COPY --from=build /repo/node_modules ./node_modules
USER node
EXPOSE 8080
CMD ["node", "dist/main.js"]

{
  "name": "cashfold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:no-float": "node scripts/check-no-float.mjs",
    "check:desktop-config": "node scripts/check-desktop-config.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "verify": "pnpm typecheck && pnpm lint && vitest run",
    "check:sqlite3mc": "node scripts/verify-sqlite3mc.mjs",
    "gen:migrations": "node scripts/gen-migrations.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}

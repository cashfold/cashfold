<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- What the browser engine inside Electron needs to run JavaScript and WebAssembly under the hardened runtime, and nothing more:
         no network-client or server entitlement (the app is not sandboxed by Apple's app sandbox), no file access, no camera or microphone. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>

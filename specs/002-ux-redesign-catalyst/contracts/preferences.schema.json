{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashfold.invalid/schemas/ui-preferences.v1.json",
  "title": "Interface preferences (device-local, never synced or exported)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v"],
  "properties": {
    "v": { "const": 1 },
    "theme": { "enum": ["system", "light", "dark"], "default": "system" },
    "language": { "enum": ["auto", "en", "uk", "pl"], "default": "auto", "description": "The interface language; auto follows the browser (spec 004)." },
    "moreDetailsOpen": { "type": "boolean", "default": false },
    "optionalFields": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2}\\.[a-zA-Z]+$" },
      "additionalProperties": { "type": "boolean" },
      "maxProperties": 64
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["thisMonth", "lastMonth", "thisYear", "lastYear", "last30", "last90", "all"] } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "from", "to"], "properties": { "kind": { "const": "custom" }, "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } } }
          ]
        },
        "collapsed": { "type": "array", "items": { "enum": ["category", "tag", "trend", "balance", "accounts"] }, "uniqueItems": true }
      }
    },
    "plan": { "type": "object", "additionalProperties": false, "properties": { "view": { "enum": ["budgets", "goals", "schedules"] } } },
    "recents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 64 }, "maxProperties": 16 },
        "categories": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 8 }, "maxProperties": 16 }
      }
    },
    "hints": { "type": "object", "additionalProperties": false, "properties": { "dismissed": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 32, "uniqueItems": true } } },
    "firstRun": { "type": "object", "additionalProperties": false, "properties": { "dismissed": { "type": "boolean" } } },
    "lists": { "type": "object", "additionalProperties": false, "properties": { "showArchivedAccounts": { "type": "boolean" } } }
  }
}
